# ---------------------------------------------------------------- identity
# Any email address on these domains can sign in. Comma-separated.
ALLOWED_EMAIL_DOMAINS=availproject.org

# Signing/encryption key for sessions, env vars and stored git tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AVAIL_SECRET=change-me-to-a-long-random-string

# Return the login code in the API response when email delivery is not
# configured. Turn this OFF once SMTP works.
AUTH_DEV_ECHO=true

# SMTP delivery for sign-in codes. Without it codes are printed to the API log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Avail Deploy <deploy@availproject.org>

# ------------------------------------------------------------------- ports
API_PORT=3001
PROXY_PORT=3002
DASHBOARD_PORT=3000
HOST=127.0.0.1

API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000

# Wildcard base domain for deployment hostnames. `*.localhost` resolves to
# 127.0.0.1 in every modern browser, so previews work with no DNS setup.
DEPLOYMENT_DOMAIN=avail.localhost
DEPLOYMENT_SCHEME=http

# ----------------------------------------------------------------- storage
# Database and platform metadata. Keep this OUTSIDE the platform repository,
# otherwise builds inherit the platform's own node_modules and npm workspace.
# AVAIL_DATA_DIR=C:\Users\you\.avail-deploy

# Where builds actually run and artifacts are stored. On Windows this is
# auto-detected to the WSL-native filesystem
# (\\wsl.localhost\<distro>\home\<user>\.avail-deploy), because a workspace on
# a mounted Windows drive crosses the 9p bridge for every dependency file and
# makes `npm install` several times slower. Set this only to override.
# AVAIL_WORKSPACE_DIR=

# Set to false to keep builds on the Windows drive — slower, but browsable in
# Explorer without the \\wsl.localhost share.
WSL_NATIVE_WORKSPACE=true

# ------------------------------------------------------------------ builds
# `wsl` runs build commands inside WSL (default on Windows), `local` uses the
# host shell (default elsewhere).
BUILD_EXECUTOR=wsl
WSL_DISTRO=Ubuntu
BUILD_CONCURRENCY=2
BUILD_TIMEOUT_MINUTES=30
DEFAULT_NODE_VERSION=22.x
KEEP_DEPLOYMENTS_PER_PROJECT=20

# ----------------------------------------------------------------- runtime
RUNTIME_IDLE_MINUTES=15
RUNTIME_BOOT_TIMEOUT_SECONDS=90
FUNCTION_MAX_DURATION=60

# ------------------------------------------------------------------ github
# OAuth app (optional): enables "Continue with GitHub" and one-click repo access.
# Callback URL: http://localhost:3001/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Fallback secret for webhooks that were not created through the dashboard.
# GITHUB_WEBHOOK_SECRET=

# Poll connected repositories when no public webhook URL is reachable.
GITHUB_POLL_ENABLED=true
GITHUB_POLL_INTERVAL_SECONDS=60
