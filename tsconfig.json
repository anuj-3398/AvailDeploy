{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "apps/builder/src/**/*.ts",
    "apps/proxy/src/**/*.ts",
    "apps/cli/src/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "exclude": ["node_modules", "**/dist"]
}
